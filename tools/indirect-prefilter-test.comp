#version 460
#extension GL_GOOGLE_include_directive : require
#include "common/indirect_prefilter.glsl"

layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Results { vec4 result[]; };
uint fixture;
bool outOfBounds;
ivec2 fixtureSize;

IndirectFilterSample loadIndirectFilterSample(ivec2 pixel) {
    if (any(lessThan(pixel, ivec2(0))) || any(greaterThanEqual(pixel, fixtureSize))) { outOfBounds = true; }
    vec3 albedo = vec3(0.25, 0.5, 0.75);
    if (fixture == 1u) {
        albedo = ((pixel.x + pixel.y) % 2 == 0) ? vec3(0.05, 0.2, 0.9) : vec3(0.8, 0.4, 0.1);
    }
    float illumination = 2.0;
    if (fixture == 2u || fixture >= 10u) { illumination += (pixel.x + pixel.y) % 2 == 0 ? 1.0 : -1.0; }
    bool acrossEdge = pixel.x > 3;
    if (fixture >= 3u && fixture <= 6u && acrossEdge) { illumination = 100.0; }
    IndirectFilterSample value = IndirectFilterSample(albedo * illumination, albedo,
        vec3(vec2(pixel) * 0.01, 0.0), vec3(0, 0, 1), vec3(0, 0, 1), 1.0, true);
    if (fixture == 3u && acrossEdge) { value.position.z = 1.0; }
    if (fixture == 4u && acrossEdge) { value.geometricNormal = vec3(0, 1, 0); }
    if (fixture == 5u && acrossEdge) { value.shadingNormal = vec3(0, 1, 0); }
    if (fixture == 6u && acrossEdge) { value.roughness = 0.2; }
    if (fixture == 7u && any(notEqual(pixel, ivec2(3)))) {
        value.radiance = vec3(uintBitsToFloat(0x7fc00000u));
        value.valid = false;
    }
    if (fixture == 9u) { value.valid = false; }
    return value;
}

void main() {
    fixture = gl_GlobalInvocationID.x;
    if (fixture >= 12u) { return; }
    fixtureSize = fixture == 8u ? ivec2(2) : ivec2(8);
    ivec2 pixel = fixture == 8u ? ivec2(0) : ivec2(3);
    outOfBounds = false;
    IndirectFilterSample center = loadIndirectFilterSample(pixel);
    vec3 filtered = center.valid ? reconstructIndirect(pixel, fixtureSize, center) : center.radiance;
    if (fixture >= 10u) {
        vec3 transmission = fixture == 10u ? vec3(0.2, 0.4, 0.8) : vec3(0, 0.48, 0.65) * 0.3 * vec3(0.7, 0.9, 1.0);
        vec3 directAndEmission = vec3(5, 6, 7);
        vec3 additiveFog = vec3(0.1, 0.3, 0.7);
        vec3 originalHdr = (directAndEmission + center.radiance) * transmission + additiveFog;
        filtered = composeReconstructedIndirect(originalHdr, center.radiance, filtered, transmission);
    }
    result[fixture] = vec4(filtered, outOfBounds ? 0.0 : 1.0);
}
