#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_atomic_int64 : require
#extension GL_EXT_control_flow_attributes : require

#define SHARC_ENABLE_GLSL 1
#define SHARC_ENABLE_64_BIT_ATOMICS 1
#define SHARC_UPDATE 1
#define SHARC_QUERY 1
#define SHARC_SEPARATE_EMISSIVE TEST_SEPARATE_EMISSION
#include "SharcGlsl.h"
#include "SharcCommon.h"

layout(local_size_x = 1) in;
layout(std430, set = 0, binding = 0) buffer Results { uint result[]; };
layout(push_constant) uniform Addresses {
    uint64_t hashes;
    uint64_t accumulation;
    uint64_t resolved;
} addresses;

void clearData(SharcParameters p) {
    for (uint i = 0; i < 16; ++i) {
        p.hashMapData.hashEntriesBuffer.data[i] = uint64_t(0);
        p.accumulationBuffer.data[i].data = uvec4(0);
        p.resolvedBuffer.data[i] = SharcPackVoxelData(vec3(0), 0, 0, 0, 0);
    }
    memoryBarrierBuffer();
}

void recordAccumulation(SharcParameters p, uint slot, uint offset) {
    memoryBarrierBuffer();
    uvec4 value = p.accumulationBuffer.data[slot].data;
    for (uint i = 0; i < 4; ++i) result[offset + i] = value[i];
}

bool submitHit(SharcParameters p, inout SharcState state, SharcHitData hit, vec3 reflected, vec3 emission) {
#if SHARC_SEPARATE_EMISSIVE
    hit.emissive = emission;
    return SharcUpdateHit(p, state, hit, reflected, 0);
#else
    return SharcUpdateHit(p, state, hit, reflected + emission, 0);
#endif
}

void main() {
    SharcParameters p;
    p.hashMapData.capacity = 16;
    p.hashMapData.hashEntriesBuffer = RWStructuredBuffer_uint64_t(addresses.hashes);
    p.accumulationBuffer = RWStructuredBuffer_SharcAccumulationData(addresses.accumulation);
    p.resolvedBuffer = RWStructuredBuffer_SharcPackedData(addresses.resolved);
    p.gridParameters.cameraPosition = vec3(0);
    p.gridParameters.logarithmBase = SHARC_GRID_LOGARITHM_BASE;
    p.gridParameters.sceneScale = 64;
    p.gridParameters.levelBias = SHARC_GRID_LEVEL_BIAS;
    p.radianceScale = 1000;
    p.enableAntiFireflyFilter = false;
    SharcHitData hit;
    hit.positionWorld = vec3(1, 2, 3);
    hit.normalWorld = vec3(0, 1, 0);
#if SHARC_SEPARATE_EMISSIVE
    hit.emissive = vec3(0);
#endif
    result[0] = 0x5090CAFEu;

    clearData(p);
    SharcState state;
    SharcInit(state);
    submitHit(p, state, hit, vec3(1, 2, 3), vec3(10, 20, 30));
    memoryBarrierBuffer();
    uint slot = HashMapFindEntry(p.hashMapData, hit.positionWorld, hit.normalWorld, p.gridParameters);
    recordAccumulation(p, slot, 1);

    // Cache payload from the preceding surface. A query can have different
    // local emission even inside the same spatial cache cell.
#if SHARC_SEPARATE_EMISSIVE
    p.resolvedBuffer.data[slot] = SharcPackVoxelData(vec3(1, 2, 3), 64, 1, 0, 0);
    hit.emissive = vec3(20, 30, 40);
#else
    p.resolvedBuffer.data[slot] = SharcPackVoxelData(vec3(11, 22, 33), 64, 1, 0, 0);
#endif
    memoryBarrierBuffer();
    vec3 queried = vec3(0);
    result[5] = uint(SharcGetCachedRadiance(p, hit, queried, false));
    result[6] = uint(round(queried.x * 1000));
    result[7] = uint(round(queried.y * 1000));
    result[8] = uint(round(queried.z * 1000));

    clearData(p);
    slot = HashMapInsertEntry(p.hashMapData, hit.positionWorld, hit.normalWorld, p.gridParameters);
    uint prior = (slot + 1u) % 16u;
    p.hashMapData.hashEntriesBuffer.data[prior] = uint64_t(123456789);
    p.accumulationBuffer.data[prior].data.w = 1;
    memoryBarrierBuffer();
    SharcInit(state);
    state.pathLength = 1;
    state.cacheIndices[0] = prior;
    state.sampleWeights[0] = vec3(0.5, 0.25, 2);
    bool continues = submitHit(p, state, hit, vec3(1, 2, 3), vec3(10, 20, 30));
    result[21] = uint(continues);
    result[22] = uint(slot < 16u && prior != slot);
    recordAccumulation(p, prior, 9);
    if (continues) {
        SharcSetThroughput(state, vec3(0.25, 0.5, 0.125));
        SharcUpdateMiss(p, state, vec3(4, 8, 12));
    }
    recordAccumulation(p, prior, 13);
    recordAccumulation(p, slot, 17);
    result[23] = 0xC0DEC0DEu;

    // A resampled hit must use the existing reflected cache plus the current
    // emitter value, propagate it once, and leave the local accumulator alone.
    clearData(p);
    slot = HashMapInsertEntry(p.hashMapData, hit.positionWorld, hit.normalWorld, p.gridParameters);
    prior = (slot + 1u) % 16u;
    p.hashMapData.hashEntriesBuffer.data[prior] = uint64_t(123456789);
    p.accumulationBuffer.data[prior].data.w = 1;
#if SHARC_SEPARATE_EMISSIVE
    p.resolvedBuffer.data[slot] = SharcPackVoxelData(vec3(1, 2, 3), 64, 1, 0, 0);
#else
    p.resolvedBuffer.data[slot] = SharcPackVoxelData(vec3(11, 22, 33), 64, 1, 0, 0);
#endif
    memoryBarrierBuffer();
    SharcInit(state);
    state.pathLength = 1;
    state.cacheIndices[0] = prior;
    state.sampleWeights[0] = vec3(0.5, 0.25, 2);
    result[24] = uint(submitHit(p, state, hit, vec3(9), vec3(20, 30, 40)));
    recordAccumulation(p, prior, 25);
    recordAccumulation(p, slot, 29);
    result[33] = 0xC0DEC0DEu;
}
