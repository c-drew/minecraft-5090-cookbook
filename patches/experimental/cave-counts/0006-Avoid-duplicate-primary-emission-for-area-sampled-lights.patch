index 0000000..e1e71e6
--- /dev/null
+++ b/src/shader/world/ray_tracing/internal/advanced/common/primary_nee_coverage.glsl
@@ -0,0 +1,64 @@
+#ifndef ADV_PRIMARY_NEE_COVERAGE_GLSL
+#define ADV_PRIMARY_NEE_COVERAGE_GLSL
+
+#include "common/light.glsl"
+#include "common/light_neighborhood.glsl"
+
+// A conservative support test for the existing area-light proposal. This
+// does not test whether its one realized sample selected this emitter: a
+// sampled estimator accounts for every light in its proposal's support.
+bool primaryNeePointOnTriangle(vec3 point, vec3 a, vec3 b, vec3 c) {
+    vec3 e0 = b - a;
+    vec3 e1 = c - a;
+    vec3 q = point - a;
+    vec3 n = cross(e0, e1);
+    float n2 = dot(n, n);
+    if (!(n2 > 1e-12)) { return false; }
+    // Much tighter than reservoir reuse's 0.02-block plane tolerance.
+    if (abs(dot(q, n)) > 0.0005 * sqrt(n2)) { return false; }
+    float d00 = dot(e0, e0), d01 = dot(e0, e1), d11 = dot(e1, e1);
+    float d20 = dot(q, e0), d21 = dot(q, e1);
+    float denominator = d00 * d11 - d01 * d01;
+    if (!(denominator > 1e-12)) { return false; }
+    float v = (d11 * d20 - d01 * d21) / denominator;
+    float w = (d00 * d21 - d01 * d20) / denominator;
+    return v >= -0.0001 && w >= -0.0001 && v + w <= 1.0001;
+}
+
+bool primaryNeeCoversEmitter(vec3 sceneOrigin, vec3 sceneHit, vec3 direction) {
+    vec3 origin = sceneOrigin + vec3(worldUBO.cameraPos.xyz);
+    vec3 point = sceneHit + vec3(worldUBO.cameraPos.xyz);
+    if (any(isnan(origin)) || any(isinf(origin)) || any(isnan(point)) || any(isinf(point))) { return false; }
+    int centerIndex;
+    ivec3 centerOrigin;
+    if (!tryGetChunkIndexFromSectionCoordinate(ivec3(floor(origin / 16.0)), worldUBO,
+                                               centerIndex, centerOrigin)) { return false; }
+    if (!chunkPackedDataMatchesOrigin(chunkPackedData[centerIndex], centerOrigin)) { return false; }
+    uint count = min(chunkLightNeighborhoods[centerIndex].header.x, uint(ADV_CHUNK_NEIGHBORHOOD_CAPACITY));
+    for (uint n = 0u; n < count; ++n) {
+        ChunkLightNeighborhoodEntry entry = chunkLightNeighborhoods[centerIndex].entries[n];
+        if (!(entry.probability > 1e-8) || entry.chunkIndex >= uint(chunkPackedData.length())) { continue; }
+        ChunkLightData data = chunkPackedData[entry.chunkIndex];
+        if (!chunkPackedDataHasLights(data)) { continue; }
+        ivec3 expectedSection = ivec3(data.x, data.y, data.z) / 16;
+        int checkedIndex;
+        ivec3 checkedOrigin;
+        if (!tryGetChunkIndexFromSectionCoordinate(expectedSection, worldUBO, checkedIndex, checkedOrigin) ||
+            checkedIndex != int(entry.chunkIndex) || !chunkPackedDataMatchesOrigin(data, checkedOrigin)) { continue; }
+        // Only skip far chunk boxes. Unusually extended block geometry keeps
+        // its original BSDF-hit emission if this conservative search misses it.
+        vec3 chunkOrigin = vec3(data.x, data.y, data.z);
+        if (any(lessThan(point, chunkOrigin - 1.0)) || any(greaterThan(point, chunkOrigin + 17.0))) { continue; }
+        ChunkPackedLightBuffer lightBuffer = ChunkPackedLightBuffer(data.lightBufferAddress);
+        for (uint i = 0u; i < data.lightCount; ++i) {
+            ChunkPackedLight light = lightBuffer.lights[i];
+            if (!(light.p0Area.w > 1e-8) || !(max(light.radiance.r, max(light.radiance.g, light.radiance.b)) > 1e-8) ||
+                !(dot(light.normal.xyz, -direction) > 1e-6)) { continue; }
+            if (primaryNeePointOnTriangle(point, light.p0Area.xyz, light.p1.xyz, light.p2.xyz) ||
+                primaryNeePointOnTriangle(point, light.p0Area.xyz, light.p2.xyz, light.p3.xyz)) { return true; }
+        }
+    }
+    return false;
+}
+
+#endif
