@@ -613,6 +615,11 @@ void main() {
         // Hit shaders are shared, so a ray flag carries the update distinction.
         float emissionFactor = (bounce == 0u && localBounce == 0 && !rayIsSharcUpdate(mainRay)) ?
                                    ADV_DIRECT_LIGHT_STRENGTH : ADV_INDIRECT_LIGHT_STRENGTH;
+        if (rayHasPrimaryAreaNee(mainRay) && !rayIsSharcUpdate(mainRay) &&
