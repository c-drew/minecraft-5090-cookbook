--- a/src/shader/util/ray.glsl
+++ b/src/shader/util/ray.glsl
@@ -26,6 +26,15 @@ const uint raySurfaceCacheTargetSecondaryBit = 1u << 18u;
 const uint rayIndirectVolumetricCloudBit = 1u << 19u;
 // Shared hit shaders need the update/query distinction in the ray payload.
 const uint raySharcUpdateBit = 1u << 20u;
+const uint rayPrimaryAreaNeeBit = 1u << 21u;
+
+void raySetPrimaryAreaNee(inout MainRay ray, bool enabled) {
+    ray.stateBits = enabled ? (ray.stateBits | rayPrimaryAreaNeeBit) : (ray.stateBits & ~rayPrimaryAreaNeeBit);
+}
+
+bool rayHasPrimaryAreaNee(MainRay ray) {
+    return (ray.stateBits & rayPrimaryAreaNeeBit) != 0u;
+}
 
