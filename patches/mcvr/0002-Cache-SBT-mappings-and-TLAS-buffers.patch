-WorldPrepareContext::CachedChunkRow &
-WorldPrepareContext::refreshCachedChunkRow(size_t index, const std::shared_ptr<Chunk1> &chunk) {
-    if (cachedChunkRows.size() <= index) { cachedChunkRows.resize(index + 1); }
