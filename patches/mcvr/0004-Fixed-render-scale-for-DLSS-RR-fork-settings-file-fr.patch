diff --git a/src/core/util/cpu_frame_log.hpp b/src/core/util/cpu_frame_log.hpp
new file mode 100644
index 0000000..98035b9
--- /dev/null
+++ b/src/core/util/cpu_frame_log.hpp
@@ -0,0 +1,74 @@
+#pragma once
+// RTX 5090 fork: per-frame render-thread timeline, for finding CPU-side frame spikes.
+// Enabled when MCVR_CPU_FRAME_LOG names a file. The JNI entry points mark checkpoints; each frame
+// (acquireContext to the next acquireContext) becomes one CSV line with every checkpoint's offset in ms
+// from the frame start. The gaps between native checkpoints are Java work on the render thread.
+// Each line also carries the frame start as Unix time (ms, for matching JFR samples) and every engine
+// profiler zone that took >= 0.1 ms on the render thread in that frame (name=ms; needs MCVR_TIMING_FILE,
+// which turns the profiler on).
+#include "common/profiler.hpp"
+#include <array>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <string>
+
+namespace mcvr_cpu_frame {
+
+enum Mark { AcquireBegin, AcquireEnd, EntityBegin, EntityEnd, SubmitBegin, SubmitEnd, PresentBegin, PresentEnd, Count };
+
+struct State {
+    FILE *out = nullptr;
+    std::array<double, Count> t{};
+    std::chrono::steady_clock::time_point start{};
+    double startUnixMs = 0.0;
+    std::map<std::string, double> previousZoneMs;
+    unsigned long long frame = 0;
+    bool started = false;
+    State() {
+        if (const char *path = std::getenv("MCVR_CPU_FRAME_LOG")) {
+            out = std::fopen(path, "w");
+            if (out) std::fprintf(out, "frame,unix_ms,total,acquire_end,entity_begin,entity_end,submit_begin,submit_end,present_begin,present_end,zones\n");
+        }
+    }
+};
+
+inline State &state() {
+    static State s;
+    return s;
+}
+
+inline void mark(Mark m) {
+    State &s = state();
+    if (s.out == nullptr) return;
+    auto now = std::chrono::steady_clock::now();
+    if (m == AcquireBegin) {
+        if (s.started) {
+            double total = std::chrono::duration<double, std::milli>(now - s.start).count();
+            std::fprintf(s.out, "%llu,%.3f,%.3f", s.frame++, s.startUnixMs, total);
+            for (int i = AcquireEnd; i < Count; i++) std::fprintf(s.out, ",%.3f", s.t[i]);
+            if (mcvr::profiler::Profiler::isEnabled()) {
+                mcvr::profiler::Profiler::flushCurrentThread();
+                std::fputc(',', s.out);
+                for (auto &zone : mcvr::profiler::Profiler::snapshot().zones) {
+                    double &previous = s.previousZoneMs[zone.name];
+                    if (zone.totalMilliseconds < previous) previous = 0.0; // the 300-frame timing reset
+                    double delta = zone.totalMilliseconds - previous;
+                    previous = zone.totalMilliseconds;
+                    if (delta >= 0.1) std::fprintf(s.out, "%s=%.3f;", zone.name.c_str(), delta);
+                }
+            }
+            std::fputc('\n', s.out);
+        }
+        s.start = now;
+        s.startUnixMs =
+            std::chrono::duration<double, std::milli>(std::chrono::system_clock::now().time_since_epoch()).count();
+        s.started = true;
+        s.t.fill(-1.0);
+        return;
+    }
+    if (s.started) s.t[m] = std::chrono::duration<double, std::milli>(now - s.start).count();
+}
+
+} // namespace mcvr_cpu_frame
diff --git a/src/core/util/fork_config.hpp b/src/core/util/fork_config.hpp
new file mode 100644
index 0000000..527514a
--- /dev/null
+++ b/src/core/util/fork_config.hpp
@@ -0,0 +1,43 @@
+#pragma once
+// RTX 5090 fork: settings for the fork's engine features. Each setting is read from its environment
+// variable (e.g. MCVR_RENDER_SCALE) or, when that is not set, from the same key in
+// <game dir>/radiance/fork.properties (KEY=VALUE lines, '#' comments). The file survives launcher
+// settings rewrites, so the play instance keeps its render scale there.
+#include <cstdlib>
+#include <fstream>
+#include <map>
+#include <string>
+
+namespace mcvr_fork {
+
+inline const std::map<std::string, std::string> &fileSettings() {
+    static const std::map<std::string, std::string> settings = [] {
+        std::map<std::string, std::string> result;
+        std::ifstream in("radiance/fork.properties");
+        std::string line;
+        while (std::getline(in, line)) {
+            auto start = line.find_first_not_of(" \t");
+            if (start == std::string::npos || line[start] == '#') continue;
+            auto eq = line.find('=', start);
+            if (eq == std::string::npos) continue;
+            auto trim = [](std::string s) {
+                auto a = s.find_first_not_of(" \t\r");
+                auto b = s.find_last_not_of(" \t\r");
+                return a == std::string::npos ? std::string() : s.substr(a, b - a + 1);
+            };
+            result[trim(line.substr(start, eq - start))] = trim(line.substr(eq + 1));
+        }
+        return result;
+    }();
+    return settings;
+}
+
+/** The setting's value, or nullptr when neither the environment nor fork.properties sets it. */
+inline const char *setting(const char *name) {
+    if (const char *v = std::getenv(name)) return v;
+    auto &settings = fileSettings();
+    auto it = settings.find(name);
+    return it == settings.end() ? nullptr : it->second.c_str();
+}
+
+} // namespace mcvr_fork
diff --git a/src/core/util/gpu_timing.hpp b/src/core/util/gpu_timing.hpp
new file mode 100644
index 0000000..3258656
--- /dev/null
+++ b/src/core/util/gpu_timing.hpp
@@ -0,0 +1,130 @@
+#pragma once
+// RTX 5090 fork: GPU time per world-render section, from Vulkan timestamps.
+// Enabled only when MCVR_TIMING_FILE is set. One query pool per frame slot;
+// a slot's results are read when it is reused, after its fence was waited on,
+// so reading never stalls. The time between consecutive stamps is charged to
+// the name of the earlier stamp. Every 300 frames the per-frame averages are
+// appended to MCVR_TIMING_FILE as one JSON line with "gpu." keys.
+// MCVR_TIMING_FRAMES (optional, a file path) also writes every frame's section times, one CSV-ish
+// line per frame: index followed by name=ms pairs.
+#include "core/all_extern.hpp"
+#include "common/profiler.hpp"
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <mutex>
+#include <set>
+#include <string>
+#include <vector>
+
+namespace mcvr_gpu_timing {
+
+constexpr uint32_t kMaxStamps = 128;
+
+struct Slot {
+    VkQueryPool pool = VK_NULL_HANDLE;
+    std::vector<std::string> names;
+    bool pending = false;
+};
+
+struct State {
+    const char *path = std::getenv("MCVR_TIMING_FILE");
+    FILE *framesOut = std::getenv("MCVR_TIMING_FRAMES") ? std::fopen(std::getenv("MCVR_TIMING_FRAMES"), "w") : nullptr;
+    uint64_t frameIndex = 0;
+    VkDevice device = VK_NULL_HANDLE;
+    double periodNs = 1.0;
+    std::vector<Slot> slots;
+    Slot *current = nullptr;
+    VkCommandBuffer cmd = VK_NULL_HANDLE;
+    std::map<std::string, double> totals;
+    int frames = 0;
+    bool frames_file() const { return framesOut != nullptr; }
+};
+
+inline State &state() {
+    static State s;
+    return s;
+}
+
+inline bool enabled() { return state().path != nullptr; }
+
+/** Stable C string for profiler zone names built at runtime (the profiler keeps the pointer). */
+inline const char *intern(const std::string &name) {
+    static std::mutex mutex;
+    static std::set<std::string> names;
+    std::lock_guard lock(mutex);
+    return names.insert(name).first->c_str();
+}
+
+inline void collect(Slot &slot) {
+    State &s = state();
+    if (!slot.pending || slot.names.size() < 2) return;
+    std::vector<uint64_t> stamps(slot.names.size());
+    VkResult r = vkGetQueryPoolResults(s.device, slot.pool, 0, (uint32_t)stamps.size(),
+                                       stamps.size() * sizeof(uint64_t), stamps.data(), sizeof(uint64_t),
+                                       VK_QUERY_RESULT_64_BIT);
+    if (r != VK_SUCCESS) return;
+    if (s.frames_file()) std::fprintf(s.framesOut, "%llu", (unsigned long long)s.frameIndex++);
+    for (size_t i = 0; i + 1 < stamps.size(); i++) {
+        if (stamps[i + 1] >= stamps[i]) {
+            double ms = (stamps[i + 1] - stamps[i]) * s.periodNs * 1e-6;
+            s.totals[slot.names[i]] += ms;
+            if (s.framesOut) std::fprintf(s.framesOut, ",%s=%.4f", slot.names[i].c_str(), ms);
+        }
+    }
+    if (s.framesOut) std::fputc('\n', s.framesOut);
+    if (++s.frames >= 300) {
+        if (FILE *f = std::fopen(s.path, "a")) {
+            std::fprintf(f, "{\"gpu_frames\":%d", s.frames);
+            for (auto &[name, ms] : s.totals) std::fprintf(f, ",\"gpu.%s\":%.4f", name.c_str(), ms / s.frames);
+            // CPU zones from the engine profiler: ms per frame and the worst single call.
+            mcvr::profiler::Profiler::flushCurrentThread();
+            for (auto &zone : mcvr::profiler::Profiler::snapshot().zones) {
+                std::fprintf(f, ",\"cpu.%s\":%.4f,\"cpumax.%s\":%.4f", zone.name.c_str(),
+                             zone.totalMilliseconds / s.frames, zone.name.c_str(),
+                             mcvr::profiler::Profiler::ticksToMilliseconds(zone.maxTicks));
+            }
+            mcvr::profiler::Profiler::reset();
+            std::fprintf(f, "}\n");
+            std::fclose(f);
+        }
+        s.totals.clear();
+        s.frames = 0;
+    }
+}
+
+// Call right after the frame's world command buffer begins.
+inline void beginFrame(VkDevice device, double timestampPeriodNs, uint32_t slotIndex, VkCommandBuffer cmd) {
+    if (!enabled()) return;
+    State &s = state();
+    if (!mcvr::profiler::Profiler::isEnabled()) mcvr::profiler::Profiler::setEnabled(true);
+    s.device = device;
+    s.periodNs = timestampPeriodNs;
+    if (s.slots.size() <= slotIndex) s.slots.resize(slotIndex + 1);
+    Slot &slot = s.slots[slotIndex];
+    if (slot.pool == VK_NULL_HANDLE) {
+        VkQueryPoolCreateInfo info{};
+        info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+        info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+        info.queryCount = kMaxStamps;
+        if (vkCreateQueryPool(device, &info, nullptr, &slot.pool) != VK_SUCCESS) return;
+    } else {
+        collect(slot);
+    }
+    vkCmdResetQueryPool(cmd, slot.pool, 0, kMaxStamps);
+    slot.names.clear();
+    slot.pending = true;
+    s.current = &slot;
+    s.cmd = cmd;
+}
+
+inline void stamp(const std::string &name) {
+    if (!enabled()) return;
+    State &s = state();
+    if (s.current == nullptr || s.current->names.size() >= kMaxStamps) return;
+    vkCmdWriteTimestamp(s.cmd, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, s.current->pool,
+                        (uint32_t)s.current->names.size());
+    s.current->names.push_back(name);
+}
+
+} // namespace mcvr_gpu_timing
diff --git a/src/shader/world/ray_tracing/internal/advanced/common/render_size.glsl b/src/shader/world/ray_tracing/internal/advanced/common/render_size.glsl
new file mode 100644
index 0000000..40a8345
--- /dev/null
+++ b/src/shader/world/ray_tracing/internal/advanced/common/render_size.glsl
@@ -0,0 +1,22 @@
+#ifndef ADV_RENDER_SIZE_GLSL
+#define ADV_RENDER_SIZE_GLSL
+
+// RTX 5090 fork: dynamic resolution. Render-resolution images keep their full size and a frame
+// renders into the top-left sub-rectangle given by WorldUBO.renderSizePacked (width | height << 16,
+// 0 when dynamic resolution is off). prevRenderSizePacked is the previous frame's size, for
+// temporal reprojection into last frame's images.
+ivec2 advUnpackRenderSize(uint packedSize, ivec2 fullSize) {
+    if (packedSize == 0u) { return fullSize; }
+    return min(ivec2(int(packedSize & 0xFFFFu), int(packedSize >> 16u)), fullSize);
+}
+
+// A pixel position (pixel centers at +0.5) in this frame's render size, in last frame's.
+vec2 advToPrevRenderPixel(vec2 pixelCenter, ivec2 currentSize, ivec2 prevSize) {
+    return pixelCenter * vec2(prevSize) / vec2(currentSize);
+}
+
+ivec2 advDownsampledSize(ivec2 size, int factor) {
+    return (size + ivec2(factor - 1)) / factor;
+}
+
+#endif
