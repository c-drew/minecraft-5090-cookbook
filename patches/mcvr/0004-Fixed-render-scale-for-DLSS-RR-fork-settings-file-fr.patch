index 0000000..7848208
--- /dev/null
+++ b/src/core/render/dynamic_resolution.hpp
@@ -0,0 +1,290 @@
+#pragma once
+// RTX 5090 fork: dynamic render resolution for DLSS Ray Reconstruction.
+//
+// Every render-resolution image keeps its full size (the DLSS mode's optimal input size, the
+// "max" here). Each frame renders into the top-left sub-rectangle `renderSize()` of those images
+// and DLSS-RR is told the sub-rectangle, so the output stays 2560x1440 while the traced pixel
+// count follows the GPU load: a controller keeps the measured GPU frame time under a target
+// derived from the frame rate cap, lowering the render scale at once when a frame runs over and
+// raising it slowly when there is headroom.
+//
+// GPU time comes from four timestamps in the world command buffer: frame start, after the
+// acceleration structure builds, before the upscaler (between these two is the part that scales
+// with the pixel count) and after the world pipeline. A slot's
+// results are read when the slot is reused, after its fence was waited on, so reading never stalls.
+//
+// DLSS-RR spends ~14 ms of CPU on every render size change (measured 2026-09-25, driver 615.71,
+// DLSS 310.5.3, also between two sizes it used before), so the dynamic mode is off by default
+// and a fixed render scale is the practical use.
+//
+// Configuration (environment, read once):
+//   MCVR_RENDER_SCALE   fixed per-axis scale of the DLSS mode's render size, e.g. 0.8125
+//   MCVR_DRS            1 enables the dynamic controller (default off)
+//   MCVR_DRS_TARGET_MS  GPU time target; default 0.90 x the frame time of the fps cap (or of 141 fps)
+//   MCVR_DRS_MIN_SCALE  lowest per-axis scale relative to the max size (default 0.75, i.e. Quality
+//                       -> Performance at 1440p)
+//   MCVR_DRS_LEVELS     number of discrete render sizes from 1.0 down to the min scale (default 5).
+//                       DLSS-RR does expensive CPU work (tens of ms) when the render size changes to
+//                       one it has not used recently, so sizes are quantized and changed sparingly.
+//   MCVR_DRS_CYCLE      N: step through the levels every N frames (for measuring switch costs)
+//   MCVR_DRS_FIXED      "W H": force this render size (for measurements)
+//   MCVR_DRS_LOG        a file that gets one line per second with scale and GPU times
+//   MCVR_DRS_FRAME_LOG  a file that gets every frame's GPU times (prepare, scaled, total) as CSV
+#include "core/util/fork_config.hpp"
+#include "core/all_extern.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+namespace mcvr::drs {
+
+constexpr uint32_t kStamps = 4;
+
+struct Slot {
+    VkQueryPool pool = VK_NULL_HANDLE;
+    uint32_t written = 0;
+    bool pending = false;
+    uint32_t width = 0, height = 0;
+};
+
+struct State {
+    bool configured = false;
+    bool enabled = false;
+    bool dynamic = false;
+    float fixedScale = 0.0f;
+    double targetMs = 0.0; // 0: from the fps cap
+    float minScale = 0.75f;
+    uint32_t fixedWidth = 0, fixedHeight = 0;
+    int levels = 5;
+    int cycle = 0;
+    int level = 0; // current level, 0 = full size
+    int raiseFrames = 0;
+    FILE *log = nullptr;
+    FILE *frameLog = nullptr;
+
+    uint32_t maxWidth = 0, maxHeight = 0; // allocated render size
+    uint32_t minWidth = 0, minHeight = 0; // DLSS lower bound
+    uint32_t width = 0, height = 0;       // this frame
+    uint32_t prevWidth = 0, prevHeight = 0;
+    float scale = 1.0f; // per axis, relative to max
+
+    VkDevice device = VK_NULL_HANDLE;
+    double periodNs = 1.0;
+    std::vector<Slot> slots;
+    Slot *current = nullptr;
+    VkCommandBuffer cmd = VK_NULL_HANDLE;
+
+    // controller
+    double scaledMsEma = 0.0, fixedMsEma = 0.0, totalMsEma = 0.0;
+    int framesSinceDrop = 0;
+    // log
+    double logTotal = 0.0, logScaled = 0.0, logScale = 0.0, logMaxTotal = 0.0;
+    int logFrames = 0;
+    int logSwitches = 0;
+    uint64_t frameCounter = 0;
+};
+
+inline State &state() {
+    static State s;
+    return s;
+}
+
+inline void readConfig() {
+    State &s = state();
+    if (s.configured) return;
+    s.configured = true;
+    if (const char *v = std::getenv("MCVR_DRS")) s.dynamic = std::atoi(v) != 0;
+    if (const char *v = mcvr_fork::setting("MCVR_RENDER_SCALE")) s.fixedScale = std::clamp((float)std::atof(v), 0.3f, 1.0f);
+    if (const char *v = std::getenv("MCVR_DRS_TARGET_MS")) s.targetMs = std::atof(v);
+    if (const char *v = std::getenv("MCVR_DRS_MIN_SCALE")) s.minScale = std::clamp((float)std::atof(v), 0.3f, 1.0f);
+    if (const char *v = std::getenv("MCVR_DRS_FIXED")) std::sscanf(v, "%u %u", &s.fixedWidth, &s.fixedHeight);
+    if (const char *v = std::getenv("MCVR_DRS_LEVELS")) s.levels = std::clamp(std::atoi(v), 1, 32);
+    if (const char *v = std::getenv("MCVR_DRS_CYCLE")) s.cycle = std::max(0, std::atoi(v));
+    if (const char *v = std::getenv("MCVR_DRS_LOG")) s.log = std::fopen(v, "a");
+    if (const char *v = std::getenv("MCVR_DRS_FRAME_LOG")) {
+        s.frameLog = std::fopen(v, "w");
+        if (s.frameLog) std::fprintf(s.frameLog, "frame,prepare_ms,scaled_ms,total_ms,width,height\n");
+    }
+    s.enabled = s.dynamic || s.fixedScale > 0.0f || s.fixedWidth > 0 || s.cycle > 0 || s.frameLog != nullptr;
+}
+
+/** Called by the upscaler when its render-resolution images are (re)created. */
+inline void setLimits(uint32_t maxWidth, uint32_t maxHeight, uint32_t minWidth, uint32_t minHeight) {
+    readConfig();
+    State &s = state();
+    s.maxWidth = maxWidth;
+    s.maxHeight = maxHeight;
+    s.minWidth = std::min(minWidth, maxWidth);
+    s.minHeight = std::min(minHeight, maxHeight);
+    s.width = s.prevWidth = maxWidth;
+    s.height = s.prevHeight = maxHeight;
+    s.scale = 1.0f;
+    s.level = 0;
+    s.raiseFrames = 0;
+    s.scaledMsEma = s.fixedMsEma = s.totalMsEma = 0.0;
+    for (Slot &slot : s.slots) slot.pending = false;
+}
+
+inline bool active() {
+    State &s = state();
+    return s.enabled && s.maxWidth > 0;
+}
+
+/** Render size of the frame being recorded (the full image size when DRS is off). */
+inline uint32_t width() { return state().width; }
+inline uint32_t height() { return state().height; }
+inline uint32_t prevWidth() { return state().prevWidth; }
+inline uint32_t prevHeight() { return state().prevHeight; }
+
+inline double frameBudgetMs(uint32_t fpsCap) {
+    uint32_t fps = (fpsCap == 0 || fpsCap >= 260) ? 141 : fpsCap;
+    return 1000.0 / fps;
+}
+
+inline float levelScale(int level) {
+    State &s = state();
+    if (s.levels <= 1) return 1.0f;
+    return 1.0f - (1.0f - s.minScale) * (float)level / (float)(s.levels - 1);
+}
+
+inline void control(double totalMs, double scaledMs, uint32_t fpsCap) {
+    State &s = state();
+    double target = s.targetMs > 0.0 ? s.targetMs : 0.90 * frameBudgetMs(fpsCap);
+    double fixedMs = std::max(totalMs - scaledMs, 0.0);
+    // The scaled part is proportional to the pixel count of the frame it was measured on.
+    double measuredArea = std::max(1e-3, (double)s.current->width * s.current->height /
+                                             ((double)s.maxWidth * s.maxHeight));
+    double perFullFrame = scaledMs / measuredArea; // scaled cost at scale 1
+    s.fixedMsEma = s.fixedMsEma == 0.0 ? fixedMs : 0.9 * s.fixedMsEma + 0.1 * fixedMs;
+    s.scaledMsEma = s.scaledMsEma == 0.0 ? perFullFrame : 0.8 * s.scaledMsEma + 0.2 * perFullFrame;
+
+    double minArea = (double)s.minScale * s.minScale;
+    // Area that would meet the target with the costs just measured (fast, for drops) and with the
+    // smoothed costs (slow, for raises).
+    double available = target - std::max(fixedMs, s.fixedMsEma);
+    double areaNow = std::clamp(available / std::max(perFullFrame, 1e-3), minArea, 1.0);
+    double areaSmooth = std::clamp((target - s.fixedMsEma) / std::max(s.scaledMsEma, 1e-3), minArea, 1.0);
+    // Discrete levels: drop at once to the largest level that fits the frame just measured (3% margin);
+    // raise one level only after the smoothed costs have fit it with 5% to spare for a second.
+    auto levelArea = [&](int level) { return (double)levelScale(level) * levelScale(level); };
+    int level = s.level;
+    if (totalMs > target || areaNow * 0.97 < levelArea(level)) {
+        while (level < s.levels - 1 && levelArea(level) > areaNow * 0.97) level++;
+        s.raiseFrames = 0;
+    } else if (level > 0 && areaSmooth * 0.95 >= levelArea(level - 1) && areaNow * 0.95 >= levelArea(level - 1)) {
+        if (++s.raiseFrames > 144) {
+            level--;
+            s.raiseFrames = 0;
+        }
+    } else {
+        s.raiseFrames = 0;
+    }
+    s.level = level;
+    s.scale = levelScale(level);
+}
+
+/** Call right after the frame's world command buffer begins. Picks this frame's render size. */
+inline void beginFrame(VkDevice device, double timestampPeriodNs, uint32_t slotIndex, VkCommandBuffer cmd,
+                       uint32_t fpsCap) {
+    readConfig();
+    State &s = state();
+    s.prevWidth = s.width;
+    s.prevHeight = s.height;
+    s.current = nullptr;
+    if (!active()) {
+        return;
+    }
+    s.device = device;
+    s.periodNs = timestampPeriodNs;
+    if (s.slots.size() <= slotIndex) s.slots.resize(slotIndex + 1);
+    Slot &slot = s.slots[slotIndex];
+    if (slot.pool == VK_NULL_HANDLE) {
+        VkQueryPoolCreateInfo info{};
+        info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+        info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+        info.queryCount = kStamps;
+        if (vkCreateQueryPool(device, &info, nullptr, &slot.pool) != VK_SUCCESS) return;
+    } else if (slot.pending && slot.written == kStamps && slot.width > 0) {
+        uint64_t stamps[kStamps];
+        if (vkGetQueryPoolResults(device, slot.pool, 0, kStamps, sizeof(stamps), stamps, sizeof(uint64_t),
+                                  VK_QUERY_RESULT_64_BIT) == VK_SUCCESS &&
+            stamps[1] >= stamps[0] && stamps[2] >= stamps[1] && stamps[3] >= stamps[2]) {
+            double scaledMs = (stamps[2] - stamps[1]) * s.periodNs * 1e-6;
+            double totalMs = (stamps[3] - stamps[0]) * s.periodNs * 1e-6;
+            if (s.frameLog) {
+                std::fprintf(s.frameLog, "%llu,%.4f,%.4f,%.4f,%u,%u\n", (unsigned long long)s.frameCounter,
+                             (stamps[1] - stamps[0]) * s.periodNs * 1e-6, scaledMs, totalMs, slot.width, slot.height);
+            }
+            s.current = &slot;
+            if (s.dynamic) control(totalMs, scaledMs, fpsCap);
+            s.logTotal += totalMs;
+            s.logScaled += scaledMs;
+            s.logMaxTotal = std::max(s.logMaxTotal, totalMs);
+            s.logScale += s.scale;
+            s.logFrames++;
+        }
+    }
+    slot.pending = false;
+
+    if (s.cycle > 0) {
+        s.level = (int)((s.frameCounter / s.cycle) % s.levels);
+        s.scale = levelScale(s.level);
+    }
+    if (s.fixedScale > 0.0f && s.fixedWidth == 0 && !s.dynamic && s.cycle == 0) {
+        s.width = std::clamp((uint32_t)std::lround(s.maxWidth * s.fixedScale) & ~1u, s.minWidth, s.maxWidth);
+        s.height = std::clamp((uint32_t)std::lround(s.maxHeight * s.fixedScale) & ~1u, s.minHeight, s.maxHeight);
+    } else if (s.fixedWidth > 0) {
+        s.width = std::clamp(s.fixedWidth, 1u, s.maxWidth);
+        s.height = std::clamp(s.fixedHeight, 1u, s.maxHeight);
+    } else {
+        // Even sizes, never below the DLSS minimum; the full size is used exactly at level 0.
+        s.width = s.level == 0 ? s.maxWidth
+                               : std::clamp((uint32_t)std::lround(s.maxWidth * s.scale) & ~1u, s.minWidth, s.maxWidth);
+        s.height = s.level == 0 ? s.maxHeight
+                                : std::clamp((uint32_t)std::lround(s.maxHeight * s.scale) & ~1u, s.minHeight,
+                                             s.maxHeight);
+    }
+
+    if (s.width != s.prevWidth || s.height != s.prevHeight) s.logSwitches++;
+    if (s.log && s.logFrames >= 144) {
+        std::fprintf(s.log, "{\"frame\":%llu,\"scale\":%.3f,\"gpu_ms\":%.3f,\"gpu_max_ms\":%.3f,\"scaled_ms\":%.3f,"
+                            "\"size\":[%u,%u],\"level\":%d,\"switches\":%d}\n",
+                     (unsigned long long)s.frameCounter, s.logScale / s.logFrames, s.logTotal / s.logFrames,
+                     s.logMaxTotal, s.logScaled / s.logFrames, s.width, s.height, s.level, s.logSwitches);
+        s.logSwitches = 0;
+        std::fflush(s.log);
+        s.logTotal = s.logScaled = s.logScale = s.logMaxTotal = 0.0;
+        s.logFrames = 0;
+    }
+    s.frameCounter++;
+
+    vkCmdResetQueryPool(cmd, slot.pool, 0, kStamps);
+    vkCmdWriteTimestamp(cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, slot.pool, 0);
+    slot.written = 1;
+    slot.pending = true;
+    slot.width = s.width;
+    slot.height = s.height;
+    s.current = &slot;
+    s.cmd = cmd;
+}
+
+inline void stamp(VkCommandBuffer cmd, uint32_t index) {
+    State &s = state();
+    if (s.current == nullptr || s.current->written != index) return;
+    vkCmdWriteTimestamp(cmd, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, s.current->pool, index);
+    s.current->written = index + 1;
+}
+
+/** After the acceleration structure builds: from here on the work scales with the render size. */
+inline void stampAfterPrepare(VkCommandBuffer cmd) { stamp(cmd, 1); }
+
+/** Before the upscaler. */
+inline void stampBeforeUpscale(VkCommandBuffer cmd) { stamp(cmd, 2); }
+
+/** After the world pipeline. */
+inline void stampEnd(VkCommandBuffer cmd) { stamp(cmd, 3); }
+
+} // namespace mcvr::drs
