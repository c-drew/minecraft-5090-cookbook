From 0ae5c5081602a6f3ce4d0ca580468a6b712969a8 Mon Sep 17 00:00:00 2001
From: c-drew <101952850+c-drew@users.noreply.github.com>
Date: Sun, 27 Sep 2026 04:16:53 -0400
Subject: [PATCH 12/12] Shaders: add an optional camera-player block-light
 shadow switch

Default on preserves existing behavior. Disabling only PLAYER_MASK for block-light shadow rays removes the distracting player silhouette in torchlit tunnels; other entities and sun shadows remain.
---
 .../advanced/common/direct_light_visibility.glsl       | 10 +++++++++-
 .../world/ray_tracing/internal/advanced/configs.json   |  6 ++++++
 .../ray_tracing/internal/advanced/lang/en_us.lang      |  1 +
 3 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/src/shader/world/ray_tracing/internal/advanced/common/direct_light_visibility.glsl b/src/shader/world/ray_tracing/internal/advanced/common/direct_light_visibility.glsl
index 6b5ad1b..3295dbc 100644
--- a/src/shader/world/ray_tracing/internal/advanced/common/direct_light_visibility.glsl
+++ b/src/shader/world/ray_tracing/internal/advanced/common/direct_light_visibility.glsl
@@ -1,6 +1,10 @@
 #ifndef ADV_DIRECT_LIGHT_VISIBILITY_GLSL
 #define ADV_DIRECT_LIGHT_VISIBILITY_GLSL
 
+#ifndef ADV_PLAYER_BLOCK_LIGHT_SHADOWS
+#    define ADV_PLAYER_BLOCK_LIGHT_SHADOWS 1
+#endif
+
 #ifndef ADV_AREA_LIGHT_SURFACE_ORIGIN_VALIDATION
 #    define ADV_AREA_LIGHT_SURFACE_ORIGIN_VALIDATION 0
 #endif
@@ -79,7 +83,11 @@ vec3 traceAreaLightReservoirTransmission(SampledSurface surface,
 
     float shadowLength = max(distanceToLight - shadowOriginDistance - ADV_AREA_LIGHT_VISIBILITY_DISTANCE_SHRINK, 0.0001);
     if (!isFiniteVec3(shadowOrigin) || !isFiniteFloat(shadowLength)) { return vec3(0.0); }
-    traceRayEXT(topLevelAS, gl_RayFlagsNoneEXT, WORLD_MASK | PLAYER_MASK | CLOUD_MASK, 0, 0, 0, shadowOrigin, 0.0001,
+    // PLAYER_MASK is the camera's own entity; other players and mobs use WORLD_MASK.
+    // This switch affects block-light shadows, keeping sun shadows and reflections.
+    const uint blockLightShadowMask = WORLD_MASK | CLOUD_MASK |
+                                      (ADV_PLAYER_BLOCK_LIGHT_SHADOWS != 0 ? PLAYER_MASK : 0);
+    traceRayEXT(topLevelAS, gl_RayFlagsNoneEXT, blockLightShadowMask, 0, 0, 0, shadowOrigin, 0.0001,
                 sampledLightDir, shadowLength, 1);
     return shadowRay.radiance;
 }
diff --git a/src/shader/world/ray_tracing/internal/advanced/configs.json b/src/shader/world/ray_tracing/internal/advanced/configs.json
index e11d3e1..6dd871c 100644
--- a/src/shader/world/ray_tracing/internal/advanced/configs.json
+++ b/src/shader/world/ray_tracing/internal/advanced/configs.json
@@ -77,6 +77,12 @@
             "default_value": "render_pipeline.false",
             "define": "ADV_ENABLE_PARALLAX"
         },
+        {
+            "name": "render_pipeline.module.ray_tracing.attribute.player_block_light_shadows",
+            "type": "bool",
+            "default_value": "render_pipeline.true",
+            "define": "ADV_PLAYER_BLOCK_LIGHT_SHADOWS"
+        },
         {
             "name": "render_pipeline.module.ray_tracing.attribute.water_surface_mode",
             "type": "enum:render_pipeline.module.ray_tracing.attribute.water_surface_mode.vanilla-render_pipeline.module.ray_tracing.attribute.water_surface_mode.realistic",
diff --git a/src/shader/world/ray_tracing/internal/advanced/lang/en_us.lang b/src/shader/world/ray_tracing/internal/advanced/lang/en_us.lang
index 9d905f4..782b4a2 100644
--- a/src/shader/world/ray_tracing/internal/advanced/lang/en_us.lang
+++ b/src/shader/world/ray_tracing/internal/advanced/lang/en_us.lang
@@ -9,6 +9,7 @@ render_pipeline.module.ray_tracing.attribute.spatial_reuse_radius=Spatial Reuse
 render_pipeline.module.ray_tracing.attribute.spatial_reuse_disocclusion_boost_samples=Disocclusion Boost Samples
 render_pipeline.module.ray_tracing.attribute.temporal_confidence_cap=Temporal History Limit
 render_pipeline.module.ray_tracing.attribute.enable_parallax=Enable Parallax
+render_pipeline.module.ray_tracing.attribute.player_block_light_shadows=Player Shadows from Block Lights
 render_pipeline.module.ray_tracing.attribute.cloud_mode=Cloud Mode
 render_pipeline.module.ray_tracing.attribute.cloud_mode.off=Off
 render_pipeline.module.ray_tracing.attribute.cloud_mode.vanilla=Vanilla
