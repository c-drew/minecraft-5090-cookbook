     uint instanceID = gl_InstanceCustomIndexEXT;
     uint geometryID = gl_GeometryIndexEXT;
     uint geometryBufferIndex = getGeometryBufferIndex(instanceID, geometryID);
@@ -66,12 +67,16 @@ void main() {
     float lod = 0.0;
     if (hasTexture(packedData)) {
         uv = baryCoords.x * m0.textureUV + baryCoords.y * m1.textureUV + baryCoords.z * m2.textureUV;
+        lodTiles = lodTileCount(m0, m0.packedData);
+        uv = lodTileUv(uv, m0.textureUV, m1.textureUV, m2.textureUV, lodTiles);
 
         float coneRadiusWorld = mainRay.coneWidth + gl_HitTEXT * mainRay.coneSpread;
         PositionVertex p0, p1, p2;
         loadTrianglePositions(geometryBufferIndex, i0, i1, i2, p0, p1, p2);
         vec3 dposdu, dposdv;
         computedposduDv(p0.pos, p1.pos, p2.pos, m0.textureUV, m1.textureUV, m2.textureUV, dposdu, dposdv);
+        dposdu /= lodTiles;
+        dposdv /= lodTiles;
         lod = lodWithCone(textures[nonuniformEXT(textureID)], uv, coneRadiusWorld, dposdu, dposdv);
 
         alpha *= sampleTexture(textures[nonuniformEXT(textureID)], uv, lod, false).a;
