diff --git a/src/shader/util/vertex.glsl b/src/shader/util/vertex.glsl
index 669fad3..419142e 100644
--- a/src/shader/util/vertex.glsl
+++ b/src/shader/util/vertex.glsl
@@ -67,6 +67,26 @@ bool hasNoHeightSurface(uint packedData) {
     return (packedData & NO_HEIGHT_SURFACE_BIT) != 0u;
 }
 
+// RTX 5090 fork: LoD terrain (the Radiance build of Voxy) draws one quad per 2^L-block voxel with
+// the block's sprite spread across it, and stores the voxel size in blocks in glintUV.x (block
+// faces never use glint, and every glint read is gated on USE_GLINT_BIT). Repeat the sprite once
+// per block, like vanilla terrain, instead of stretching it: no magnified texels, and leaf
+// cut-outs stay leaf-sized instead of opening holes several blocks wide.
+float lodTileCount(MaterialVertex m0, uint packedData) {
+    return hasGlint(packedData) ? 1.0 : max(m0.glintUV.x, 1.0);
+}
+
+// The quad's UVs span exactly one sprite, so the triangle's UV bounds are the sprite bounds.
+vec2 lodTileUv(vec2 uv, vec2 uv0, vec2 uv1, vec2 uv2, float tiles) {
+    if (tiles <= 1.0) {
+        return uv;
+    }
+    vec2 uvMin = min(uv0, min(uv1, uv2));
+    vec2 span = max(uv0, max(uv1, uv2)) - uvMin;
+    vec2 local = (uv - uvMin) / max(span, vec2(1e-12));
+    return uvMin + fract(local * tiles) * span;
+}
+
 uint getAlphaMode(uint packedData) {
     return (packedData >> ALPHA_MODE_SHIFT) & 0xFu;
 }
