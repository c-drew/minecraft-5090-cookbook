+    private static final int RESCAN_FRAMES = 60;
+    private static BuiltChunkStorage indexedStorage = null;
+    private static int rescanCursor = 0;
+
+    // Chunks whose current data may hold block entities. Rebuilds add to the index as
+    // they happen, and every frame re-checks the next 1/60 of the storage, so each
+    // chunk is re-verified once a second and a chunk reaching block entities any other
+    // way is picked up within 60 frames. Spreading the scan keeps it from costing a
+    // few ms every 60th frame at high render distances. A new storage object (render
+    // distance change) is scanned in full. Each chunk's current data is still read every
+    // frame, so cleared or relocated chunks contribute nothing, exactly as before.
+    private static Iterable<ChunkBuilder.BuiltChunk> blockEntityChunks(BuiltChunkStorage chunks) {
+        ChunkBuilder.BuiltChunk[] all = chunks.chunks;
+        int count;
+        if (chunks != indexedStorage) {
+            ChunkProxy.BLOCK_ENTITY_CHUNKS.clear();
+            indexedStorage = chunks;
+            rescanCursor = 0;
+            count = all.length;
+        } else {
+            count = (all.length + RESCAN_FRAMES - 1) / RESCAN_FRAMES;
+        }
+        for (int n = 0; n < count && all.length > 0; n++) {
+            if (rescanCursor >= all.length) {
+                rescanCursor = 0;
+            }
+            ChunkBuilder.BuiltChunk builtChunk = all[rescanCursor++];
+            if (builtChunk.getData().getBlockEntities().isEmpty()) {
+                ChunkProxy.BLOCK_ENTITY_CHUNKS.remove(builtChunk);
+            } else {
+                ChunkProxy.BLOCK_ENTITY_CHUNKS.add(builtChunk);
+            }
+        }
+        return ChunkProxy.BLOCK_ENTITY_CHUNKS;
+    }
