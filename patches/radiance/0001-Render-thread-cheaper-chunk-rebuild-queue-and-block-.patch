+    // RTX 5090 fork: per-entity and per-block-entity vertex storage is created every
+    // frame. BufferAllocator grows on demand, so starting at 16 KB instead of 768 KB
+    // avoids hundreds of large native allocations per frame (upstream issue #252).
+    private static final int PER_OBJECT_BUFFER_BYTES = 16384;
+
+    // Render layer and content names are constants; encode each to a native string
+    // once instead of allocating and freeing two per layer per frame (issue #252).
+    private static final java.util.concurrent.ConcurrentHashMap<String, ByteBuffer> NATIVE_NAMES =
+        new java.util.concurrent.ConcurrentHashMap<>();
+    private static final int NATIVE_NAME_LIMIT = 4096;
+
+    private static ByteBuffer nativeName(String name, List<ByteBuffer> perCallBuffers) {
+        ByteBuffer cached = NATIVE_NAMES.get(name);
+        if (cached != null) {
+            return cached;
+        }
+        if (NATIVE_NAMES.size() < NATIVE_NAME_LIMIT) {
+            return NATIVE_NAMES.computeIfAbsent(name, n -> MemoryUtil.memUTF8(n, true));
+        }
+        ByteBuffer buffer = MemoryUtil.memUTF8(name, true);
+        perCallBuffers.add(buffer);
+        return buffer;
+    }
