new file mode 100644
index 0000000..b556b44
--- /dev/null
+++ b/src/main/java/com/radiance/client/proxy/world/LodBridge.java
@@ -0,0 +1,148 @@
+package com.radiance.client.proxy.world;
+
+import it.unimi.dsi.fastutil.longs.LongOpenHashSet;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicInteger;
+import net.minecraft.client.render.BuiltBuffer;
+import net.minecraft.client.render.BuiltChunkStorage;
+import net.minecraft.client.render.RenderLayer;
+import net.minecraft.client.render.chunk.ChunkBuilder;
+import net.minecraft.client.world.ClientWorld;
+import net.minecraft.util.math.BlockPos;
+import net.minecraft.util.math.ChunkPos;
+
+/**
+ * RTX 5090 fork: lets an LoD provider (the Radiance build of Voxy) put far terrain into the
+ * ray-traced scene. The native chunk store gets {@link #CAPACITY} extra slots after the
+ * vanilla chunk grid; each holds one LoD mesh at an arbitrary world origin. Grid lookups in
+ * the shaders stop at the vanilla grid size, so these slots are only ever reached by rays.
+ *
+ * <p>Slots are cleared whenever the chunk storage is rebuilt (world change, render distance
+ * change). The generation number changes at the same time; providers pass the generation
+ * they read, and uploads for an older generation are dropped.
+ */
+public final class LodBridge {
+    public static final int CAPACITY = 4096;
+
+    private static final Object LOCK = new Object();
+    private static final AtomicInteger GENERATION = new AtomicInteger();
+    private static int baseIndex = -1;
+
+    private LodBridge() {
+    }
+
+    /** Called under {@link #lock()} by ChunkProxy after the native store is (re)created. */
+    static void onStorageInit(int vanillaChunkCount) {
+        baseIndex = vanillaChunkCount;
+        GENERATION.incrementAndGet();
+    }
+
+    static Object lock() {
+        return LOCK;
+    }
+
+    public static int generation() {
+        return GENERATION.get();
+    }
+
+    public static boolean isReady() {
+        synchronized (LOCK) {
+            return baseIndex >= 0;
+        }
+    }
+
+    /**
+     * Uploads one LoD mesh. Buffers use the vanilla block vertex format, positions relative to
+     * the origin, exactly like a chunk rebuild; the caller still owns (and closes) them.
+     */
+    public static boolean upload(int generation, int slot, int originX, int originY, int originZ,
+        Map<RenderLayer, BuiltBuffer> buffers) {
+        synchronized (LOCK) {
+            if (!accepts(generation, slot)) {
+                return false;
+            }
+            if (buffers.isEmpty()) {
+                ChunkProxy.invalidateSingle(baseIndex + slot);
+            } else {
+                ChunkProxy.submitGeometry(originX, originY, originZ, baseIndex + slot, buffers, false);
+            }
+            return true;
+        }
+    }
+
+    public static void clear(int generation, int slot) {
+        synchronized (LOCK) {
+            if (accepts(generation, slot)) {
+                ChunkProxy.invalidateSingle(baseIndex + slot);
+            }
+        }
+    }
+
+    /**
+     * Chunk columns Radiance draws right now, as {@link ChunkPos#toLong} keys: the column is
+     * loaded and every one of its sections has been built (or found empty). LoD must leave
+     * exactly these out. The render-distance circle is not enough: vanilla only builds a far
+     * chunk once all four neighbours are loaded, so the outermost loaded ring (and anything
+     * still queued) is not drawn yet and would otherwise be a hole. Client thread only.
+     */
+    public static LongOpenHashSet renderedColumns(ClientWorld world) {
+        LongOpenHashSet rendered = new LongOpenHashSet();
+        BuiltChunkStorage storage = ChunkProxy.storage();
+        if (storage == null || storage.chunks == null || world == null) {
+            return rendered;
+        }
+        ChunkBuilder.BuiltChunk[] chunks = storage.chunks;
+        var manager = world.getChunkManager();
+        // The grid is sizeX * sizeY * sizeZ slots at index (z * sizeY + y) * sizeX + x, and every
+        // slot of one (x, z) keeps the same chunk column as the grid scrolls. Walk it with plain
+        // arrays: one volatile read per section, one hash insert per column (~25k sections).
+        int sizeY = world.countVerticalSections();
+        int columns = sizeY > 0 ? chunks.length / sizeY : 0;
+        int sizeX = (int) Math.round(Math.sqrt(columns));
+        if (sizeX > 0 && sizeX * sizeX * sizeY == chunks.length) {
+            boolean[] pending = new boolean[columns];
+            long[] keys = new long[columns];
+            boolean[] seen = new boolean[columns];
+            for (int i = 0; i < chunks.length; i++) {
+                ChunkBuilder.BuiltChunk chunk = chunks[i];
+                if (chunk == null) {
+                    continue;
+                }
+                int column = (i / (sizeX * sizeY)) * sizeX + i % sizeX;
+                if (chunk.data.get() == ChunkBuilder.ChunkData.UNPROCESSED) {
+                    pending[column] = true;
+                }
+                if (!seen[column]) {
+                    seen[column] = true;
+                    BlockPos origin = chunk.getOrigin();
+                    keys[column] = ChunkPos.toLong(origin.getX() >> 4, origin.getZ() >> 4);
+                }
+            }
+            for (int column = 0; column < columns; column++) {
+                long key = keys[column];
+                if (seen[column] && !pending[column]
+                    && manager.isChunkLoaded(ChunkPos.getPackedX(key), ChunkPos.getPackedZ(key))) {
+                    rendered.add(key);
+                }
+            }
+            return rendered;
+        }
+        // Unexpected grid shape: the general (slower) walk.
+        LongOpenHashSet pending = new LongOpenHashSet();
+        for (ChunkBuilder.BuiltChunk chunk : chunks) {
+            if (chunk == null) {
+                continue;
+            }
+            BlockPos origin = chunk.getOrigin();
+            long key = ChunkPos.toLong(origin.getX() >> 4, origin.getZ() >> 4);
+            (chunk.data.get() == ChunkBuilder.ChunkData.UNPROCESSED ? pending : rendered).add(key);
+        }
+        rendered.removeAll(pending);
+        rendered.removeIf((long key) -> !manager.isChunkLoaded(ChunkPos.getPackedX(key), ChunkPos.getPackedZ(key)));
+        return rendered;
+    }
+
+    private static boolean accepts(int generation, int slot) {
+        return baseIndex >= 0 && generation == GENERATION.get() && slot >= 0 && slot < CAPACITY;
+    }
+}
