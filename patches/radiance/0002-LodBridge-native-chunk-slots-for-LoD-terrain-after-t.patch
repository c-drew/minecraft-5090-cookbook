+    /**
+     * RTX 5090 fork: writes the current vertex's glint UV. Only LoD terrain uses it, to carry its
+     * voxel size in blocks for per-block texture tiling in the ray tracing shaders; block faces
+     * never use glint, and every glint read in the shaders is gated on the glint flag.
+     */
+    public void setGlintUV(float u, float v) {
+        int off = this.offsetsByElementId[PBR_GLINT_UV.id()];
+        if (off >= 0 && this.vertexPointer != -1L) {
+            MemoryUtil.memPutFloat(this.vertexPointer + off, u);
+            MemoryUtil.memPutFloat(this.vertexPointer + off + 4L, v);
+        }
+    }
+
     private long beginVertex(int glintTextureID) {
         ensureBuilding();
         endVertex();
