+#ifndef ADV_PLAYER_LIGHT_EVAL_GLSL
+#define ADV_PLAYER_LIGHT_EVAL_GLSL
+#include "common/player_light_buffer.glsl"
+
+vec3 samplePlayerAreaLight(DirectLightPreparedSurface p, vec3 viewDir, uint seed) {
+    uint chosen = 0u;
+    float totalWeight = 0.0;
+    float chosenWeight = 0.0;
+    for (uint i = 0u; i < playerLightCount(); ++i) {
+        PlayerAreaLight light = playerAreaLights[i];
+        vec3 center = (light.p0Area.xyz + light.p1.xyz + light.p2.xyz) / 3.0;
+        vec3 delta = center - p.surface.worldPos;
+        float d2 = dot(delta, delta);
+        // Do not reject by the centroid normal: a triangle can cross
+        // the receiver horizon. This weight only chooses a proposal.
+        float power = dot(light.radiance.rgb, vec3(0.2126, 0.7152, 0.0722));
+        float weight = light.p0Area.w * power / max(d2, 0.0001);
+        if (!(weight > 0.0) || isnan(weight) || isinf(weight)) { continue; }
+        totalWeight += weight;
+        if (rand(seed) * totalWeight < weight) { chosen = i; chosenWeight = weight; }
+    }
+    if (!(chosenWeight > 0.0)) { return vec3(0.0); }
+    PlayerAreaLight light = playerAreaLights[chosen];
+    float r = sqrt(rand(seed));
+    float t = rand(seed);
+    vec3 point = (1.0 - r) * light.p0Area.xyz + r * (1.0 - t) * light.p1.xyz + r * t * light.p2.xyz;
+    vec3 delta = point - p.surface.worldPos;
+    float d2 = dot(delta, delta);
+    if (!(d2 > 1e-8)) { return vec3(0.0); }
+    vec3 direction = delta * inversesqrt(d2);
+    if (dot(direction, p.surface.geometricNormal) <= 0.0) { return vec3(0.0); }
+    float facing = dot(light.normal.xyz, -direction);
+    if (!(abs(facing) > 1e-6)) { return vec3(0.0); }
+    float pdf;
+    vec3 brdf = DisneyEval(p.surface.mat, viewDir, p.surface.shadingNormal, direction, pdf);
+    if (!(pdf > 1e-6) || !isFiniteVec3(brdf)) { return vec3(0.0); }
+    vec3 visibility = traceAreaLightReservoirTransmissionMasked(p.surface, p.referenceUv,
+        p.referenceWorldPos, p.atlasUvMin, p.atlasUvMax, p.dPduWorld, p.dPdvWorld,
+        p.baseGeoNormal, p.traceLocalHeight, p.normalTextureID, p.maxDepthWorld,
+        point, facing > 0.0 ? light.normal.xyz : -light.normal.xyz,
+        rayInsideBoat(mainRay), WORLD_MASK | PLAYER_MASK | FISHING_BOBBER_MASK |
+        WEATHER_MASK | PARTICLE_MASK | CLOUD_MASK, true);
+    // Match the previous first-secondary hit's emission scale (indirect),
+    // rather than applying the stronger configured block-NEE scale.
+    return ADV_INDIRECT_LIGHT_STRENGTH * light.radiance.rgb * brdf *
+           (abs(facing) / d2) * (light.p0Area.w * totalWeight / chosenWeight) * visibility;
+}
+#endif
