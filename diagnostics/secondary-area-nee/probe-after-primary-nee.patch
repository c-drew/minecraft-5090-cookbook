+++ w/src/shader/world/ray_tracing/internal/advanced/common/secondary_area_nee.glsl
@@ -0,0 +1,85 @@
+#ifndef ADV_SECONDARY_AREA_NEE_GLSL
+#define ADV_SECONDARY_AREA_NEE_GLSL
+
+// Camera continuation only. Cache-update paths retain their existing estimator.
+// Four independent proposals and one visibility ray estimate direct emission
+// at the first rough secondary wall. Zero candidates still count as attempts.
+vec3 sampleSecondaryAreaNee(SampledSurface surface, vec3 viewDir, uint seed, out bool supported) {
+    supported = false;
+    vec3 origin = surface.worldPos + vec3(worldUBO.cameraPos.xyz);
+    int center;
+    ivec3 centerOrigin;
+    if (!tryGetChunkIndexFromSectionCoordinate(ivec3(floor(origin / 16.0)), worldUBO, center, centerOrigin) ||
+        !chunkPackedDataMatchesOrigin(chunkPackedData[center], centerOrigin)) { return vec3(0.0); }
+    uint count = chunkLightNeighborhoods[center].header.x;
+    if (count == 0u || count > uint(ADV_CHUNK_NEIGHBORHOOD_CAPACITY)) { return vec3(0.0); }
+    supported = true;
+    vec3 chosenPoint = vec3(0.0);
+    vec3 chosenContribution = vec3(0.0);
+    float chosenTarget = 0.0;
+    float weightSum = 0.0;
+    const int attempts = 4;
+    for (int sampleIndex = 0; sampleIndex < attempts; ++sampleIndex) {
+        uint slot = min(uint(rand(seed) * float(count)), count - 1u);
+        ChunkLightNeighborhoodEntry first = chunkLightNeighborhoods[center].entries[slot];
+        if (rand(seed) >= first.aliasProbability) { slot = first.aliasIndex; }
+        if (slot >= count) { continue; }
+        ChunkLightNeighborhoodEntry entry = chunkLightNeighborhoods[center].entries[slot];
+        if (!(entry.probability > 1e-8) || entry.chunkIndex >= uint(chunkPackedData.length())) { continue; }
+        ChunkLightData chunk = chunkPackedData[entry.chunkIndex];
+        if (!chunkPackedDataHasLights(chunk)) { continue; }
+        int checkedIndex;
+        ivec3 checkedOrigin;
+        if (!tryGetChunkIndexFromSectionCoordinate(ivec3(chunk.x, chunk.y, chunk.z) / 16, worldUBO,
+                                                   checkedIndex, checkedOrigin) ||
+            checkedIndex != int(entry.chunkIndex) || !chunkPackedDataMatchesOrigin(chunk, checkedOrigin)) { continue; }
+        ChunkPackedLightBuffer lights = ChunkPackedLightBuffer(chunk.lightBufferAddress);
+        uint lightIndex = min(uint(rand(seed) * float(chunk.lightCount)), chunk.lightCount - 1u);
+        ChunkPackedLight light = lights.lights[lightIndex];
+        if (!(light.p0Area.w > 1e-8) ||
+            !(max(light.radiance.r, max(light.radiance.g, light.radiance.b)) > 1e-8)) { continue; }
+        vec3 a = light.p0Area.xyz;
+        vec3 b = light.p1.xyz;
+        vec3 c = light.p2.xyz;
+        float area0 = length(cross(b - a, c - a));
+        float area1 = length(cross(c - a, light.p3.xyz - a));
+        if (!(area0 + area1 > 1e-12)) { continue; }
+        if (rand(seed) * (area0 + area1) >= area0) { b = c; c = light.p3.xyz; }
+        float r = sqrt(rand(seed));
+        float t = rand(seed);
+        vec3 point = (1.0 - r) * a + r * (1.0 - t) * b + r * t * c - vec3(worldUBO.cameraPos.xyz);
+        vec3 delta = point - surface.worldPos;
+        float d2 = dot(delta, delta);
+        if (!(d2 > 1e-8)) { continue; }
+        vec3 direction = delta * inversesqrt(d2);
+        float facing = dot(light.normal.xyz, -direction);
+        if (!(facing > 1e-6) || dot(direction, surface.geometricNormal) <= 0.0) { continue; }
+        float bsdfPdf;
+        vec3 brdf = DisneyEval(surface.mat, viewDir, surface.shadingNormal, direction, bsdfPdf);
+        if (!(bsdfPdf > 1e-6) || !isFiniteVec3(brdf)) { continue; }
+        float inversePdf = light.p0Area.w * float(chunk.lightCount) / entry.probability;
+        vec3 contribution = ADV_INDIRECT_LIGHT_STRENGTH * light.radiance.rgb * brdf * (facing / d2) * inversePdf;
+        float target = dot(max(contribution, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
+        if (!(target > 0.0) || !isFiniteFloat(target) || !isFiniteVec3(contribution)) { continue; }
+        weightSum += target;
+        if (rand(seed) * weightSum < target) {
+            chosenPoint = point;
+            chosenContribution = contribution;
+            chosenTarget = target;
+        }
+    }
+    if (!(chosenTarget > 0.0)) { return vec3(0.0); }
+    vec3 shadowOrigin = surface.worldPos + surface.geometricNormal * 0.0002;
+    vec3 delta = chosenPoint - shadowOrigin;
+    float distanceToLight = length(delta);
+    if (!(distanceToLight > 0.0021)) { return vec3(0.0); }
+    shadowRay.radiance = vec3(0.0);
+    shadowRay.throughput = vec3(1.0);
+    shadowRay.insideBoat = rayInsideBoat(mainRay) ? 1u : 0u;
+    shadowRay.pad0 = 1u;
+    traceRayEXT(topLevelAS, gl_RayFlagsNoneEXT,
+                WORLD_MASK | PLAYER_MASK | FISHING_BOBBER_MASK | WEATHER_MASK | PARTICLE_MASK | CLOUD_MASK,
+                0, 0, 0, shadowOrigin, 0.0001, delta / distanceToLight, distanceToLight - 0.002, 1);
+    return chosenContribution * (weightSum / (float(attempts) * chosenTarget)) * shadowRay.radiance;
+}
+#endif
