index 0000000000000000000000000000000000000000..0a43242003d274c391add2b83c7a5a81c715c892
--- /dev/null
+++ i/src/shader/world/ray_tracing/internal/advanced/common/continuation_light_guide.glsl
@@ -0,0 +1,48 @@
+#ifndef ADV_CONTINUATION_LIGHT_GUIDE_GLSL
+#define ADV_CONTINUATION_LIGHT_GUIDE_GLSL
+
+#include "common/light.glsl"
+#include "common/continuation_guide_sampling.glsl"
+
+// Diagnostic variants: 1 = SHaRC update paths; 2 = all rough opaque paths.
+#define ADV_CONTINUATION_LIGHT_GUIDE_SCOPE 1
+
+ContinuationGuide chooseContinuationGuide(vec3 relativePosition, vec3 normal, WorldUBO world, inout uint seed) {
+    ContinuationGuide guide = emptyContinuationGuide();
+    vec3 position = relativePosition + vec3(world.cameraPos.xyz);
+    ivec3 section = ivec3(floor(position / 16.0));
+    int selectedChunk = -1;
+    float totalCount = 0.0;
+    // SHaRC runs before the neighborhood alias pass. Read the current chunk
+    // metadata directly, checking the ring-buffer origin before dereferencing.
+    for (int i = 0; i < 27; ++i) {
+        ivec3 offset = ivec3(i % 3, (i / 3) % 3, i / 9) - ivec3(1);
+        int chunkIndex;
+        ivec3 origin;
+        if (!tryGetChunkIndexFromSectionCoordinate(section + offset, world, chunkIndex, origin)) { continue; }
+        ChunkLightData data = chunkPackedData[chunkIndex];
+        if (!chunkPackedDataMatchesOrigin(data, origin) || !chunkPackedDataHasLights(data)) { continue; }
+        float count = float(data.lightCount);
+        totalCount += count;
+        if (selectedChunk < 0 || rand(seed) * totalCount < count) { selectedChunk = chunkIndex; }
+    }
+    if (selectedChunk < 0) { return guide; }
+    ChunkLightData data = chunkPackedData[selectedChunk];
+    uint index = min(uint(rand(seed) * float(data.lightCount)), data.lightCount - 1u);
+    ChunkPackedLight light = ChunkPackedLightBuffer(data.lightBufferAddress).lights[index];
+    vec3 center = (light.p0Area.xyz + light.p1.xyz + light.p2.xyz) / 3.0;
+    vec3 delta = center - position;
+    float distance2 = dot(delta, delta);
+    if (isnan(distance2) || isinf(distance2) || distance2 < 1e-6) { return guide; }
+    guide.axis = delta * inversesqrt(distance2);
+    // Discard an unhelpful proposal before selecting the BSDF branch.
+    if (dot(guide.axis, normal) <= 0.0) { return emptyContinuationGuide(); }
+    // A broad cap covers neighboring emissive texture triangles. A proposal
+    // restricted to one tiny triangle would miss most of the same emitter.
+    const float radius = 0.75;
+    guide.cosMin = min(sqrt(distance2 / (distance2 + radius * radius)), 0.9995);
+    guide.probability = 0.5;
+    return guide;
+}
+
+#endif
