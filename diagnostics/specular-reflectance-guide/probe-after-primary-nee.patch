+#ifndef ADV_SPECULAR_REFLECTANCE_GUIDE_GLSL
+#define ADV_SPECULAR_REFLECTANCE_GUIDE_GLSL
+
+// Directional hemispherical GGX approximation recommended by NVIDIA's
+// Streamline ProgrammingGuideDLSS_RR.md, section 4.2.1 (Ray Tracing Gems ch.32).
+// Expanded scalar polynomials avoid HLSL/GLSL matrix-storage ambiguity.
+// The existing Disney BSDF uses alpha = roughness * roughness.
+vec3 specularReflectanceGuide(vec3 f0, float roughness, float nDotV) {
+    float v = clamp(abs(nDotV), 0.0, 1.0);
+    float a = roughness * roughness;
+    float a2 = a * a;
+    float a3 = a2 * a;
+    float v2 = v * v;
+    float v3 = v2 * v;
+    float bias = ((0.99044 - 1.28514 * v) + (1.29678 - 0.755907 * v) * a) /
+                 ((1.0 + 2.92338 * v + 59.4188 * v3) +
+                  (20.3225 - 27.0302 * v + 222.592 * v3) * a +
+                  (121.563 + 626.13 * v + 316.627 * v3) * a3);
+    float scale = ((0.0365463 + 3.32707 * v) + (9.0632 - 9.04756 * v) * a) /
+                  ((1.0 + 3.59685 * v2 - 1.36772 * v3) +
+                   (9.04401 - 16.3174 * v2 + 9.22949 * v3) * a +
+                   (5.56589 + 19.7886 * v2 - 20.2123 * v3) * a3);
+    bias *= clamp(f0.g * 50.0, 0.0, 1.0);
+    return clamp(f0 * max(scale, 0.0) + vec3(max(bias, 0.0)), vec3(0.0), vec3(1.0));
+}
+#endif
