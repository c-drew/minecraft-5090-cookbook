+#ifndef ADV_INDIRECT_PREFILTER_GLSL
+#define ADV_INDIRECT_PREFILTER_GLSL
+
+#ifndef ADV_INDIRECT_PREFILTER_RADIUS
+#define ADV_INDIRECT_PREFILTER_RADIUS 0
+#endif
+
+struct IndirectFilterSample {
+    vec3 radiance;
+    vec3 albedo;
+    vec3 position;
+    vec3 geometricNormal;
+    vec3 shadingNormal;
+    float roughness;
+    bool valid;
+};
+
+// Supplied by the runtime image loader or the independent GPU fixture.
+IndirectFilterSample loadIndirectFilterSample(ivec2 pixel);
+
+bool indirectFilterFinite(vec3 value) {
+    return !any(isnan(value)) && !any(isinf(value));
+}
+
+float indirectFilterKernel(int offset) {
+#if ADV_INDIRECT_PREFILTER_RADIUS == 1
+    return offset == 0 ? 1.0 : 0.5;
+#else
+    return offset == 0 ? 1.0 : abs(offset) == 1 ? (2.0 / 3.0) : (1.0 / 6.0);
+#endif
+}
+
+vec3 reconstructIndirect(ivec2 pixel, ivec2 resolution, IndirectFilterSample center) {
+#if ADV_INDIRECT_PREFILTER_RADIUS == 0
+    return center.radiance;
+#else
+    vec3 centerAlbedo = max(center.albedo, vec3(0.001));
+    vec3 sum = center.radiance / centerAlbedo;
+    float weightSum = 1.0;
+    for (int y = -ADV_INDIRECT_PREFILTER_RADIUS; y <= ADV_INDIRECT_PREFILTER_RADIUS; ++y) {
+        for (int x = -ADV_INDIRECT_PREFILTER_RADIUS; x <= ADV_INDIRECT_PREFILTER_RADIUS; ++x) {
+            if (x == 0 && y == 0) { continue; }
+            ivec2 neighbor = pixel + ivec2(x, y);
+            if (any(lessThan(neighbor, ivec2(0))) || any(greaterThanEqual(neighbor, resolution))) { continue; }
+            IndirectFilterSample sampleValue = loadIndirectFilterSample(neighbor);
+            if (!sampleValue.valid) { continue; }
+
+            // Symmetric plane distance prevents borrowing light across separate
+            // surfaces, including parallel foreground/background silhouettes.
+            vec3 delta = sampleValue.position - center.position;
+            float planeError = max(abs(dot(delta, center.geometricNormal)),
+                                   abs(dot(delta, sampleValue.geometricNormal)));
+            if (planeError > 0.04 || dot(center.geometricNormal, sampleValue.geometricNormal) < 0.95) { continue; }
+            float normalWeight = pow(clamp(dot(center.shadingNormal, sampleValue.shadingNormal), 0.0, 1.0), 32.0);
+            float weight = indirectFilterKernel(x) * indirectFilterKernel(y) * normalWeight *
+                exp2(-planeError * 200.0 - abs(center.roughness - sampleValue.roughness) * 16.0);
+
+            // Remove/reapply the albedo guide so texture contrast is not averaged
+            // with the illumination. No luminance/firefly clamp is introduced.
+            sum += weight * sampleValue.radiance / max(sampleValue.albedo, vec3(0.001));
+            weightSum += weight;
+        }
+    }
+    vec3 reconstructed = centerAlbedo * (sum / weightSum);
+    return indirectFilterFinite(reconstructed) ? reconstructed : center.radiance;
+#endif
+}
+
+vec3 composeReconstructedIndirect(vec3 hdr, vec3 original, vec3 reconstructed, vec3 transmission) {
+    // The HDR image already contains the original continuation, direct light,
+    // emission and additive fog. Replace just the transmitted continuation.
+    return hdr + (reconstructed - original) * transmission;
+}
+
+#endif
