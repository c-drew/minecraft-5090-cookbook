@@ -0,0 +1,54 @@
+#version 460
+#extension GL_GOOGLE_include_directive : require
+
+#include "common/shared.hpp"
+#include "common/render_size.glsl"
+#include "common/indirect_prefilter.glsl"
+
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+layout(set = 2, binding = 0) uniform WorldUniform { WorldUBO worldUBO; };
+layout(set = 3, binding = 0, rgba16f) uniform image2D outputImage;
+layout(set = 3, binding = 1, rgba8) uniform readonly image2D diffuseAlbedoImage;
+layout(set = 3, binding = 2, rgba8) uniform readonly image2D specularAlbedoImage;
+layout(set = 3, binding = 3, rgba16f) uniform readonly image2D normalRoughnessImage;
+layout(set = 5, binding = 3, rgba32f) uniform readonly image2DArray primarySurfaceCacheImage;
+layout(set = 5, binding = 36, rgba16f) uniform readonly image2DArray indirectReconstructionImage;
+
+IndirectFilterSample loadIndirectFilterSample(ivec2 pixel) {
+    vec4 raw = imageLoad(indirectReconstructionImage, ivec3(pixel, 0));
+    IndirectFilterSample value = IndirectFilterSample(raw.rgb, vec3(1.0), vec3(0.0),
+        vec3(0.0, 0.0, 1.0), vec3(0.0, 0.0, 1.0), 1.0, raw.a > 0.5);
+    if (!value.valid) { return value; }
+    vec4 normalRoughness = imageLoad(normalRoughnessImage, pixel);
+    vec3 geometricNormal = imageLoad(primarySurfaceCacheImage, ivec3(pixel, 3)).xyz;
+    value.position = imageLoad(primarySurfaceCacheImage, ivec3(pixel, 0)).xyz;
+    value.albedo = imageLoad(diffuseAlbedoImage, pixel).rgb + imageLoad(specularAlbedoImage, pixel).rgb;
+    value.roughness = normalRoughness.a;
+    value.valid = indirectFilterFinite(raw.rgb) && all(greaterThanEqual(raw.rgb, vec3(0.0))) &&
+        indirectFilterFinite(value.position) && indirectFilterFinite(normalRoughness.xyz) &&
+        indirectFilterFinite(geometricNormal) && !isnan(value.roughness) && !isinf(value.roughness) &&
+        dot(normalRoughness.xyz, normalRoughness.xyz) > 1e-6 && dot(geometricNormal, geometricNormal) > 1e-6;
+    if (value.valid) {
+        value.shadingNormal = normalize(normalRoughness.xyz);
+        value.geometricNormal = normalize(geometricNormal);
+    }
+    return value;
+}
+
+void main() {
+#if ADV_INDIRECT_PREFILTER_RADIUS != 0
+    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
+    ivec2 resolution = min(imageSize(outputImage), advUnpackRenderSize(worldUBO.renderSizePacked, imageSize(outputImage)));
+    if (any(greaterThanEqual(pixel, resolution))) { return; }
+    vec4 transmission = imageLoad(indirectReconstructionImage, ivec3(pixel, 1));
+    if (transmission.a < 0.5 || !indirectFilterFinite(transmission.rgb)) { return; }
+    IndirectFilterSample center = loadIndirectFilterSample(pixel);
+    if (!center.valid) { return; }
+    vec4 hdr = imageLoad(outputImage, pixel);
+    vec3 reconstructed = reconstructIndirect(pixel, resolution, center);
+    vec3 composed = composeReconstructedIndirect(hdr.rgb, center.radiance, reconstructed, transmission.rgb);
+    if (indirectFilterFinite(composed) && all(lessThanEqual(composed, vec3(65504.0)))) {
+        imageStore(outputImage, pixel, vec4(max(composed, vec3(0.0)), hdr.a));
+    }
+#endif
+}
