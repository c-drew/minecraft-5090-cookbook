+// Private GLSL audit: native allocation always provides and zeroes this lock
+// buffer. The 64-bit atomic path does not use it, so two words can count failed
+// and attempted insertions without changing cache lookup/insert behavior.
+#if SHARC_ENABLE_GLSL && HASH_GRID_ENABLE_64_BIT_ATOMICS
+layout(std430, set = 4, binding = 4) buffer SharcAllocationAudit {
+    uint sharcAllocationAudit[];
+};
+#endif
 
 // Constants
 #define HASH_GRID_POSITION_BIT_NUM          17
@@ -195,6 +204,9 @@
 
 bool HashMapInsert(in HashMapData hashMapData, const HashGridKey hashKey, out HashGridIndex cacheIndex)
 {
+#if SHARC_ENABLE_GLSL && HASH_GRID_ENABLE_64_BIT_ATOMICS
+    atomicAdd(sharcAllocationAudit[1], 1u);
+#endif
     const uint baseSlot = HashGridGetBaseSlot(hashKey, hashMapData.capacity);
     HASH_GRID_LOOP_ATTR
     for (uint bucketOffset = 0; bucketOffset < HASH_GRID_HASH_MAP_BUCKET_SIZE; ++bucketOffset)
@@ -210,6 +222,9 @@
         }
     }
 
+#if SHARC_ENABLE_GLSL && HASH_GRID_ENABLE_64_BIT_ATOMICS
+    atomicAdd(sharcAllocationAudit[0], 1u);
+#endif
     cacheIndex = 0;
 
     return false;
--- a/src/shader/world/ray_tracing/internal/advanced/world/world.rgen
