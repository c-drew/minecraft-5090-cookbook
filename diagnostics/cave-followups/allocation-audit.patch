@@ -1531,6 +1531,19 @@
     }
 #    endif
 
+#if SHARC_QUERY && USE_SHARC
+    // Two binary rows, least-significant bit first: failed allocations above,
+    // attempted allocations below. Colored leading tiles identify the rows.
+    // This is a diagnostic overlay only; do not score these frames for quality.
+    if (pixel.x < 33 * 12 && pixel.y < 2 * 12) {
+        uint tile = uint(pixel.x / 12);
+        uint row = uint(pixel.y / 12);
+        uint count = sharcAllocationAudit[row];
+        mainRay.radiance = tile == 0u ? (row == 0u ? vec3(8.0, 0.0, 0.0) : vec3(0.0, 8.0, 0.0)) :
+            vec3(((count >> (max(tile, 1u) - 1u)) & 1u) != 0u ? 4.0 : 0.0);
+    }
+#endif
+
     if (isnan(mainRay.radiance.r) || isinf(mainRay.radiance.r)) { mainRay.radiance = vec3(0.0, 0.0, 0.0); }
     if (isnan(mainRay.radiance.g) || isinf(mainRay.radiance.g)) { mainRay.radiance = vec3(0.0, 0.0, 0.0); }
